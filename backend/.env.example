# Application
APP_NAME="LLMOps Monitoring Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-this-in-production-min-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/llmops?sslmode=require

# Redis (Upstash or Railway)
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=sk-your_openai_key  # optional
ANTHROPIC_API_KEY=sk-ant-your_key  # optional

# Default LLM
DEFAULT_LLM_PROVIDER=groq
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password

# Telemetry (optional)
OTEL_SERVICE_NAME=llmops-platform
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Thresholds
INJECTION_THRESHOLD=0.7
TOXICITY_THRESHOLD=0.6
HALLUCINATION_THRESHOLD=0.5
